<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Live camera preview (cover-fit; OverlayView maps boxes the same way). -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Detection boxes drawn on top. -->
    <com.example.facehand.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Round framing-gallery button (bottom-left, above the objs HUD): shows a placeholder icon
         until the first shot, then the latest framing thumbnail. Tap = open the framing gallery. -->
    <ImageView
        android:id="@+id/framingThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="48dp"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_framing"
        android:background="@drawable/flip_button_bg"
        android:contentDescription="@string/open_framing_gallery" />

    <!-- Switch between front and back cameras (icon only, bottom-right). -->
    <ImageButton
        android:id="@+id/flipButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flip_camera"
        android:background="@drawable/flip_button_bg"
        android:contentDescription="@string/flip_camera" />

    <!-- Top-right stack: toggle landmarks, then open the framing gallery. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/landmarkButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_landmarks"
            android:background="@drawable/flip_button_bg"
            android:contentDescription="@string/toggle_landmarks" />

        <ImageButton
            android:id="@+id/framingGalleryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_framing"
            android:background="@drawable/flip_button_bg"
            android:contentDescription="@string/open_framing_gallery" />

        <!-- Settings: pick which detector model runs (face+hand vs +qr+barcode). -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:background="@drawable/flip_button_bg"
            android:contentDescription="@string/select_model" />
    </LinearLayout>

    <!-- Decoded QR/barcode value (ML Kit), shown briefly when a code is read; tap to copy. -->
    <TextView
        android:id="@+id/codeBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:maxWidth="320dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/code_banner_bg"
        android:textColor="#0b0f17"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:visibility="gone"
        android:contentDescription="@string/decoded_code" />

    <!-- Face gallery (top-left): icon opens the gallery; below it, the two most-recently-seen faces. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/galleryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/flip_button_bg"
            android:contentDescription="@string/open_gallery" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/recent0"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@drawable/flip_button_bg"
                android:contentDescription="@string/recent_face" />

            <ImageView
                android:id="@+id/recent1"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@drawable/flip_button_bg"
                android:contentDescription="@string/recent_face" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
